# Water Watch Environment Configuration
# Copy this file to .env and configure values for your local environment

# Backend REST API endpoint (Node.js / Express backend)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Map & Notification API keys
# EXPO_PUBLIC_MAPS_API_KEY=your_google_maps_key_here
# EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
